function selectType(type){ 
  document.getElementById('btn-cub').classList.toggle('active',type==='cub'); 
  document.getElementById('btn-new').classList.toggle('active',type==='new'); 
  document.getElementById('genderToggle').style.display='flex'; 
  document.getElementById('checklist-new').classList.toggle('active',type==='new'); 
  document.getElementById('checklist-cub').classList.toggle('active',type==='cub'); 
  renderLists(); 

 
} 

function setGender(g){ 
  currentGender=g; 
  document.getElementById('g-male').classList.toggle('active',g==='male'); 
  document.getElementById('g-female').classList.toggle('active',g==='female'); 
  renderLists(); 
} 

function renderLists(){ 
  const bottom = currentGender==='male'? items.bottoms_m : items.bottoms_f; 
  const newOrder = [items.beret, items.beret_badge, items.shirt, bottom, items.belt, items.socks, 
items.shoes, items.scarf, items.woggle, items.badges]; 
  document.getElementById('new-list').innerHTML = newOrder.map(it=>renderItem(it, 
(it===items.scarf)?'check':'need',true)).join(''); 

  const cubOrder = [ 
    {...items.beret, status:'need'}, 
    {...items.beret_badge, status:'need'}, 
    {...items.shirt, status:'have'}, 
    {...bottom, status:'have'}, 
    {...items.belt, status:'have'}, 
    {...items.socks, status:'have'}, 
    {...items.shoes, status:'have'}, 
    {...items.scarf, status:'check'}, 
    {...items.woggle, status:'need'}, 
    {...items.badges, status:'have'} 
  ]; 
  document.getElementById('cub-list').innerHTML = 
cubOrder.map(it=>renderItem(it,it.status,false)).join(''); 
} 

/* ── Unique counter so each item gets its own detail div ── */ 
let _itemId = 0; 

function renderItem(it,status,isNew){ 
  const cls = status==='have'?'have':'need'; 
  const label = status==='have'?'已擁有 可重用':status==='check'?'? 向團長查詢':'需購買'; 
  const uid = 'detail-'+(_itemId++); 
  const instruction = isNew ? (it.instructionNew || it.instruction || '') : (it.instruction || ''); 
  return ` 
  <div class="item ${cls}" onclick="toggleItem(this,'${uid}')"> 
    <div class="item-row"> 

 
 
 
 
 
      <div class="item-left"> 
        <div> 
          <div class="item-title">${it.title}</div> 
          <div class="item-desc">${it.desc}</div> 
        </div> 
      </div> 
      <div style="text-align:right"> 
        <div class="status">${label}</div> 
        <div class="arrow">›</div> 
      </div> 
    </div> 
    <div class="item-detail" id="${uid}">${instruction}</div> 
  </div>`; 
} 

function toggleItem(el, uid){ 
  /* Close any other open items in the same list */ 
  const parent = el.parentElement; 
  parent.querySelectorAll('.item.expanded').forEach(item => { 
    if (item !== el) item.classList.remove('expanded'); 
  }); 
  el.classList.toggle('expanded'); 
} 

selectType('new'); 
