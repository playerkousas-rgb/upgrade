{
  "name": "scout-upgrade-guide",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "童軍準備指南 — 香港童軍各支部制服、徽章與 2026 新訓練綱要升團準備指南（純靜態多檔 PWA）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "python3 -m http.server 8000 --bind 0.0.0.0",
    "check": "node scripts/check.js",
    "lint": "node scripts/lint.js",
    "guard": "node scripts/guard.mjs",
    "preflight": "node scripts/preflight_v1.0.mjs .",
    "final-check": "node scripts/final_check_v1.0.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.js",
    "build": "npm run check && npm run lint && node build-site.mjs",
    "make:icons": "bash scripts/make-icons.sh",
    "assets:avif": "node scripts/to-avif.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "jsdom": "^25.0.1"
  }
}
